{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date": {"type": ["string", "null"], "format": "date"},
          "description": {"type": ["string", "null"]},
          "amount": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{2}$", "description": "Positive magnitude in decimal currency units; direction is expressed by source and destination."},
          "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
          "source_account": {"type": ["string", "null"], "description": "Known account identifier, or null if unidentified."},
          "destination_account": {"type": ["string", "null"], "description": "Known account identifier, or null if unidentified."},
          "category": {"type": ["string", "null"], "enum": ["groceries", "dining", "transport", "utilities", "income", "transfer", "other", null]},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "document": {"type": "integer", "minimum": 1},
              "page": {"type": "integer", "minimum": 1},
              "quote": {"type": "string"}
            },
            "required": ["document", "page", "quote"]
          },
          "review_notes": {"type": ["string", "null"]}
        },
        "required": ["date", "description", "amount", "currency", "source_account", "destination_account", "category", "evidence", "review_notes"]
      }
    }
  },
  "required": ["transactions"]
}

