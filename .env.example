# Generate: python -c "import secrets; print(secrets.token_hex(32))"
OCR_API_KEY=
BIND_ADDRESS=127.0.0.1
OCR_PORT=8081
OCR_LANGUAGE=eng
REQUEST_TIMEOUT_SECONDS=1800
SYSTEMONE_TIMEOUT_SECONDS=600
OCR_TIMEOUT_SECONDS=120
DEBUG_MODE=FALSE

# Both URL and model are required for /v1/extract. /v1/text works without them.
# Setting these explicitly enables sending extracted document text to this endpoint.
# Use an endpoint supporting POST /chat/completions with strict json_schema output.
# Example hosted configuration: https://api.openai.com/v1 and gpt-4o-mini
# Local llama.cpp example: http://host.docker.internal:8081/v1 and your loaded model name
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Hoard Counter uses POST /v1/transactions; generic decisions use /v1/systemone.
# Both work without LLM settings.
# IP or hostname only; the rank-categorizer service uses HTTP and bearer auth.
SYSTEMONE_IP=
SYSTEMONE_PORT=8009
SYSTEMONE_API_KEY=
SYSTEMONE_MODEL=kev-latest

